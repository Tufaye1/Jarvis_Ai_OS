# Postgres
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# LLM — any OpenAI-compatible endpoint. Defaults to OpenRouter, which routes
# to Claude/GPT/Gemini/Llama etc. through one key. Get one at:
#   https://openrouter.ai/settings/keys
# Point LLM_BASE_URL at OpenAI (https://api.openai.com/v1), Groq, Together,
# or a local Ollama (http://localhost:11434/v1) to change providers.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5

# App
API_PORT=8000
WEB_PORT=3000
