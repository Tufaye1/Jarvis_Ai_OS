# Postgres
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# LLM — any OpenAI-compatible endpoint. Chat / memory-extract talk to the
# primary provider; if it errors (rate limit / bad key / out of credits /
# upstream 5xx / timeout) they automatically fall over to LLM_FALLBACKS
# in order. Common providers:
#   OpenRouter: https://openrouter.ai/api/v1        (routes to many models)
#   OpenAI:     https://api.openai.com/v1           (gpt-4o, o3, etc.)
#   Groq:       https://api.groq.com/openai/v1      (fast free tier)
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:     http://localhost:11434/v1           (local, no key)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5

# Optional ordered fallbacks. JSON list of {"api_key","base_url","model"}.
# Leave as [] for single-provider mode.
LLM_FALLBACKS=[]

# App
API_PORT=8000
WEB_PORT=3000
